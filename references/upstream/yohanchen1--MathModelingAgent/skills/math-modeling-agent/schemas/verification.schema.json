{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yohanchen1/MathModelingAgent/schemas/verification.schema.json",
  "title": "Math Modeling Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "recipeId",
    "evidenceIds",
    "verdict",
    "independenceKey"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recipeId": {
      "type": "string",
      "minLength": 1
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_RUN"
      ]
    },
    "independenceKey": {
      "type": "string",
      "minLength": 1
    },
    "derivedFrom": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
