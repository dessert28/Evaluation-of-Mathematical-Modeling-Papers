{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yohanchen1/MathModelingAgent/schemas/evidence.schema.json",
  "title": "Math Modeling Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "coveredClaimIds",
    "coveredObligationIds",
    "artifactPath",
    "inputHashes",
    "outputHashes",
    "command",
    "workdir",
    "environment",
    "exitCode",
    "methodFamily",
    "codeHash",
    "level",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "coveredClaimIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coveredObligationIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1
    },
    "inputHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "workdir": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "exitCode": {
      "type": "integer"
    },
    "methodFamily": {
      "type": "string",
      "minLength": 1
    },
    "codeHash": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "DERIVED",
        "EXECUTED",
        "VERIFIED",
        "INDEPENDENTLY_VERIFIED",
        "EXTERNALLY_VALIDATED",
        "LEGACY_UNVERIFIED"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
